#!/bin/bash
{{- $gpu := dig "gpu" "model" "" . }}
{{ if eq .chezmoi.os "linux" -}}
{{ if and (dig "gpu" "nvidia_management_services" false .) (eq $gpu "nvidia_geforce_rtx_5090") -}}
set -euo pipefail

echo "GPU {{ $gpu }}: enabling 450W power limit (nvidia-geforce-rtx-5090-power-limit.service)"

sudo install -Dm644 "{{ .chezmoi.sourceDir }}/services/systemd/system/nvidia-geforce-rtx-5090-power-limit.service" \
  /etc/systemd/system/nvidia-geforce-rtx-5090-power-limit.service

# Render hash of of the unit file so changes to unit file render as a diff for reapply
# {{ include "services/systemd/system/nvidia-geforce-rtx-5090-power-limit.service" | sha256sum }}

sudo systemctl daemon-reload
sudo systemctl enable --now nvidia-geforce-rtx-5090-power-limit.service
{{ end -}}
{{ end -}}
