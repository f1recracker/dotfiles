{{- $gitName := dig "git" "name" "" . -}}
{{- $gitEmail := dig "git" "email" "" . -}}
{{- if or $gitName $gitEmail -}}
[user]
{{- if $gitName }}
	name = {{ $gitName | quote }}
{{- end }}
{{- if $gitEmail }}
	email = {{ $gitEmail | quote }}
{{- end }}

{{ end -}}
[core]
	hooksPath = {{ .chezmoi.homeDir }}/.config/git/hooks
[color]
	ui = auto
